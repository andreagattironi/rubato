    <font app:font="@font/rubik_regular" app:fontStyle="normal" app:fontWeight="300" />
    <font app:font="@font/rubik_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font app:font="@font/rubik_medium" app:fontStyle="normal" app:fontWeight="500" />
    <font app:font="@font/rubik_medium" app:fontStyle="normal" app:fontWeight="600" />
    <font app:font="@font/rubik_bold" app:fontStyle="normal" app:fontWeight="700" />
    <font app:font="@font/rubik_bold" app:fontStyle="normal" app:fontWeight="800" />
    <font app:font="@font/rubik_bold" app:fontStyle="normal" app:fontWeight="900" />
