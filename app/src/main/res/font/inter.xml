<?xml version="1.0" encoding="utf-8"?>
<!-- Rubato: Rubik (pesi veri 400/500/700) al posto di Inter. -->
<font-family
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font app:font="@font/rubik_regular" app:fontStyle="normal" app:fontWeight="100" />
